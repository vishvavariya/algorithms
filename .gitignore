# =====================================================================
# vishva.lol .gitignore
# Keep this file in sync with AGENT_CHECKLIST.md §20.
#
# Rule of thumb: ignore anything that is (a) generated, (b) personal /
# machine-specific, (c) a secret, or (d) noise. Never ignore source code,
# lockfiles, or shared editor config that the whole team needs.
# =====================================================================

# ──────────────────────────────────────────────────────────────────
# Dependencies
# ──────────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# NOTE: package-lock.json IS committed. Never ignore lockfiles.

# ──────────────────────────────────────────────────────────────────
# Build output / compiled artifacts
# ──────────────────────────────────────────────────────────────────
.next/
out/
build/
dist/
.vercel/
.netlify/
.turbo/
.swc/
.rollup.cache/
storybook-static/

# TypeScript incremental builds
*.tsbuildinfo
next-env.d.ts.bak

# Source maps that ship outside builds
*.map.gz

# ──────────────────────────────────────────────────────────────────
# Test / coverage / profiling
# ──────────────────────────────────────────────────────────────────
coverage/
*.lcov
playwright-report/
playwright/.cache/
test-results/
e2e-results/
cypress/screenshots/
cypress/videos/
__snapshots__/__diff_output__/
.nyc_output/
*.cpuprofile
*.heapprofile
*.heapsnapshot

# ──────────────────────────────────────────────────────────────────
# Environment / secrets
# ──────────────────────────────────────────────────────────────────
# All env files except the public template.
.env
.env.*
!.env.example
!.env.sample

# Firebase / Google Cloud service accounts
serviceAccountKey.json
*serviceAccount*.json
firebase-adminsdk-*.json
gcloud-keys/

# Generic credential / cert files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
*.secrets.json

# Auth / token caches
.netrc
.npmrc.local

# ──────────────────────────────────────────────────────────────────
# Local-only application data (file fallbacks for dev mode)
# ──────────────────────────────────────────────────────────────────
.newsletter/
.ai-battle/
.feedback/

# ──────────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────────────────────────
# Editor / IDE — personal config
# ──────────────────────────────────────────────────────────────────
.idea/
.fleet/
.zed/
.history/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.project
.classpath
.factorypath

# VS Code: ignore most, allow shared bits the whole team uses.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ──────────────────────────────────────────────────────────────────
# AI assistant / agent caches (personal, not project-shared)
# ──────────────────────────────────────────────────────────────────
.cursor/
.aider*
.codeium/
.continue/
.claude/settings.local.json

# ──────────────────────────────────────────────────────────────────
# OS noise
# ──────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
.directory
.Trash-*
.nfs*

# ──────────────────────────────────────────────────────────────────
# Caches
# ──────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.tsbuildinfo
.rpt2_cache/
.rts2_cache_*

# ──────────────────────────────────────────────────────────────────
# Patch / merge / diff residue
# ──────────────────────────────────────────────────────────────────
*.rej
*.orig
*.patch.bak

# ──────────────────────────────────────────────────────────────────
# Temp files
# ──────────────────────────────────────────────────────────────────
*.tmp
*.temp
.tmp/
tmp/
scratch/

# ──────────────────────────────────────────────────────────────────
# Misc tooling
# ──────────────────────────────────────────────────────────────────
.sentryclirc
.bundle-analyzer/
bundle-stats.html
analyze-output/
